// Prisma schema file for School Management System (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  CHEQUE
  CARD
}

model School {
  id            String     @id @default(uuid())
  code          String     @unique
  name          String
  eiin          String?
  principalName String?
  address       String?    @db.Text
  phone         String?
  email         String?
  website       String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  settings              SchoolSettings?
  branding              BrandingSettings?
  websiteSettings       WebsiteSettings?
  users                 User[]
  classes               Class[]
  sections              Section[]
  groups                Group[]
  subjects              Subject[]
  academicYears         AcademicYear[]
  academicSessions      AcademicSession[]
  classSections         ClassSection[]
  classGroups           ClassGroup[]
  classSubjects         ClassSubject[]
  rooms                 Room[]
  periods               Period[]
  holidays              Holiday[]
  students              Student[]
  guardians             Guardian[]
  studentEnrollments    StudentEnrollment[]
  admissionCampaigns    AdmissionCampaign[]
  admissionApplications AdmissionApplication[]
  notifications         Notification[]
  teachers              Teacher[]
  employees             Employee[]
  departments           Department[]
  designations          Designation[]
  teacherAssignments    TeacherAssignment[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]
  payrolls              Payroll[]
  exams                 Exam[]
  auditLogs             AuditLog[]

  @@map("schools")
}

model WebsiteSettings {
  id        String   @id @default(uuid())
  schoolId  String   @unique @map("school_id")
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model SchoolSettings {
  id              String   @id @default(uuid())
  schoolId        String   @unique @map("school_id")
  currency        String   @default("BDT")
  timezone        String   @default("Asia/Dhaka")
  dateFormat      String   @default("DD/MM/YYYY") @map("date_format")
  defaultLanguage String   @default("bn") @map("default_language")
  academicYear    String   @default("2026") @map("academic_year")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model BrandingSettings {
  id           String   @id @default(uuid())
  schoolId     String   @unique @map("school_id")
  logoUrl      String?  @map("logo_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String   @default("#0d9488") @map("primary_color") // Teal
  accentColor  String   @default("#0f766e") @map("accent_color")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("branding_settings")
}

model User {
  id           String     @id @default(uuid())
  schoolId     String?    @map("school_id")
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  phone        String?
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url")
  language     String     @default("en")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  school         School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  sessions       UserSession[]
  resetTokens    PasswordResetToken[]
  loginHistories LoginHistory[]
  failedAttempts FailedLoginAttempt[]
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]
  notifications  Notification[]

  teacher  Teacher?
  employee Employee?
  student  Student?
  guardian Guardian?

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String // SUCCESS, FAILED
  loginAt   DateTime @default(now()) @map("login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_histories")
}

model FailedLoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?  @map("ip_address")
  userId    String?  @map("user_id")
  attemptAt DateTime @default(now()) @map("attempt_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("failed_login_attempts")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?  @map("school_id")
  userId    String?  @map("user_id")
  action    String // CREATE, UPDATE, DELETE, LOGIN, EXPORT
  module    String
  recordId  String?  @map("record_id")
  details   String?  @db.Text
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model AcademicYear {
  id        String     @id @default(uuid())
  schoolId  String     @map("school_id")
  name      String
  startDate DateTime   @map("start_date")
  endDate   DateTime   @map("end_date")
  isCurrent Boolean    @default(false) @map("is_current")
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessions   AcademicSession[]
  classSections      ClassSection[]
  classGroups        ClassGroup[]
  classSubjects      ClassSubject[]
  holidays           Holiday[]
  studentEnrollments StudentEnrollment[]
  admissionCampaigns AdmissionCampaign[]
  teacherAssignments TeacherAssignment[]

  @@map("academic_years")
}

model AcademicSession {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String     @map("academic_year_id")
  name           String
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@map("academic_sessions")
}

model Class {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  name         String // e.g. Class 10
  code         String // e.g. TEN
  numericLevel Int        @default(0) @map("numeric_level")
  displayOrder Int        @default(0) @map("display_order")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections              Section[]
  classSections         ClassSection[]
  classGroups           ClassGroup[]
  classSubjects         ClassSubject[]
  students              Student[]
  studentEnrollments    StudentEnrollment[]
  admissionApplications AdmissionApplication[]
  routines              Routine[]
  homeworks             Homework[]
  teacherAssignments    TeacherAssignment[]

  @@unique([schoolId, code])
  @@map("classes")
}

model Section {
  id           String     @id @default(uuid())
  schoolId     String?    @map("school_id")
  classId      String?    @map("class_id")
  name         String // e.g., Padma
  code         String     @default("SEC")
  displayOrder Int        @default(0) @map("display_order")
  capacity     Int        @default(40)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  school             School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  classSections      ClassSection[]
  students           Student[]
  studentEnrollments StudentEnrollment[]
  routines           Routine[]
  homeworks          Homework[]
  teacherAssignments TeacherAssignment[]

  @@map("sections")
}

model Group {
  id          String     @id @default(uuid())
  schoolId    String     @map("school_id")
  name        String // e.g. Science, Commerce, Humanities
  description String?    @db.Text
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroups           ClassGroup[]
  classSubjects         ClassSubject[]
  studentEnrollments    StudentEnrollment[]
  admissionApplications AdmissionApplication[]
  teacherAssignments    TeacherAssignment[]

  @@map("groups")
}

model Subject {
  id          String     @id @default(uuid())
  schoolId    String     @map("school_id")
  nameEn      String     @map("name_en")
  nameBn      String?    @map("name_bn")
  code        String
  subjectType String     @default("compulsory") @map("subject_type") // compulsory, optional, additional, practical
  description String?    @db.Text
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  marks              Mark[]
  routines           Routine[]
  homeworks          Homework[]
  teacherAssignments TeacherAssignment[]

  @@map("subjects")
}

model ClassSection {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String     @map("academic_year_id")
  classId        String     @map("class_id")
  sectionId      String     @map("section_id")
  capacity       Int        @default(40)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, sectionId])
  @@map("class_sections")
}

model ClassGroup {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String     @map("academic_year_id")
  classId        String     @map("class_id")
  groupId        String     @map("group_id")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, classId, groupId])
  @@map("class_groups")
}

model ClassSubject {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String?    @map("academic_year_id")
  classId        String     @map("class_id")
  groupId        String?    @map("group_id")
  subjectId      String     @map("subject_id")
  subjectType    String     @default("compulsory") @map("subject_type")
  fullMarks      Int        @default(100) @map("full_marks")
  passMarks      Int        @default(33) @map("pass_marks")
  status         UserStatus @default(ACTIVE)
  teacherId      String?    @map("teacher_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("class_subjects")
}

model Room {
  id        String     @id @default(uuid())
  schoolId  String     @map("school_id")
  name      String
  code      String
  capacity  Int        @default(40)
  location  String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model Period {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  name         String
  startTime    String     @map("start_time")
  endTime      String     @map("end_time")
  displayOrder Int        @default(0) @map("display_order")
  isBreak      Boolean    @default(false) @map("is_break")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("periods")
}

model Holiday {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String?    @map("academic_year_id")
  name           String
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  description    String?    @db.Text
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@map("holidays")
}

model Department {
  id        String     @id @default(uuid())
  schoolId  String     @map("school_id")
  nameEn    String     @map("name_en")
  nameBn    String?    @map("name_bn")
  code      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers  Teacher[]
  employees Employee[]

  @@unique([schoolId, code])
  @@map("departments")
}

model Designation {
  id        String     @id @default(uuid())
  schoolId  String     @map("school_id")
  nameEn    String     @map("name_en")
  nameBn    String?    @map("name_bn")
  code      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers  Teacher[]
  employees Employee[]

  @@unique([schoolId, code])
  @@map("designations")
}

model Teacher {
  id               String     @id @default(uuid())
  schoolId         String     @map("school_id")
  userId           String?    @unique @map("user_id")
  employeeCode     String     @map("employee_code")
  nameEn           String     @map("name_en")
  nameBn           String?    @map("name_bn")
  phone            String
  email            String?
  gender           Gender     @default(MALE)
  dateOfBirth      DateTime?  @map("date_of_birth")
  joiningDate      DateTime   @map("joining_date")
  qualification    String?
  specialization   String?
  profilePhoto     String?    @map("profile_photo")
  departmentId     String?    @map("department_id")
  designationId    String?    @map("designation_id")
  employmentStatus String     @default("PERMANENT") @map("employment_status")
  status           UserStatus @default(ACTIVE)
  salary           Decimal    @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  assignments         TeacherAssignment[]
  documents           EmployeeDocument[]
  employmentHistories EmploymentHistory[]
  classSubjects       ClassSubject[]
  routines            Routine[]
  homeworks           Homework[]
  payrolls            Payroll[]

  @@unique([schoolId, employeeCode])
  @@map("teachers")
}

model Employee {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  userId         String?    @unique @map("user_id")
  employeeCode   String     @map("employee_code")
  nameEn         String     @map("name_en")
  nameBn         String?    @map("name_bn")
  phone          String
  email          String?
  departmentId   String?    @map("department_id")
  designationId  String?    @map("designation_id")
  joiningDate    DateTime   @map("joining_date")
  employmentType String     @default("FULL_TIME") @map("employment_type")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  documents           EmployeeDocument[]
  employmentHistories EmploymentHistory[]

  @@unique([schoolId, employeeCode])
  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  teacherId    String?  @map("teacher_id")
  employeeId   String?  @map("employee_id")
  documentType String   @map("document_type")
  title        String
  fileUrl      String   @map("file_url")
  fileSize     Int?     @map("file_size")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  teacher  Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model EmploymentHistory {
  id               String    @id @default(uuid())
  teacherId        String?   @map("teacher_id")
  employeeId       String?   @map("employee_id")
  companyName      String    @map("company_name")
  designation      String
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  responsibilities String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  teacher  Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employment_histories")
}

model TeacherAssignment {
  id             String     @id @default(uuid())
  schoolId       String     @map("school_id")
  academicYearId String     @map("academic_year_id")
  sessionId      String?    @map("session_id")
  teacherId      String     @map("teacher_id")
  classId        String     @map("class_id")
  sectionId      String     @map("section_id")
  groupId        String?    @map("group_id")
  subjectId      String     @map("subject_id")
  isClassTeacher Boolean    @default(false) @map("is_class_teacher")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

